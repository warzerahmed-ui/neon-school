type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type StudentInput = 
 record {
   classId: opt ClassId;
   enrollmentDate: Timestamp;
   name: text;
 };
type StudentId = nat;
type Student = 
 record {
   classId: opt ClassId;
   enrollmentDate: Timestamp;
   id: StudentId;
   name: text;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DashboardStats = 
 record {
   averageClassSize: float64;
   totalClasses: nat;
   totalStudents: nat;
 };
type ClassInput = 
 record {
   name: text;
   subject: text;
 };
type ClassId = nat;
type Class = 
 record {
   id: ClassId;
   name: text;
   studentCount: nat;
   subject: text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createClass: (input: ClassInput) -> (Class);
  createStudent: (input: StudentInput) -> (Student);
  deleteClass: (id: ClassId) -> (bool);
  deleteStudent: (id: StudentId) -> (bool);
  execute: (qJson: text) -> (Result) query;
  /// Returns the backend's public API documentation as Markdown.
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getDashboardStats: () -> (DashboardStats) query;
  isCallerAdmin: () -> (bool) query;
  listClasses: () -> (vec Class) query;
  listStudents: (search: opt text, classFilter: opt ClassId) ->
   (vec Student) query;
  schema: () -> (text) query;
  updateClass: (id: ClassId, input: ClassInput) -> (opt Class);
  updateStudent: (id: StudentId, input: StudentInput) -> (opt Student);
}
